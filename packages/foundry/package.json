{
  "name": "@0gclawforge/foundry",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry Protocol 0gkit bridge for 0GClawForge — adds 0G DA publishing, TEE attestation envelopes, and a typed React/MCP-ready 0G surface alongside the existing @0gclawforge/sdk.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./da": "./src/da.ts",
    "./attestation": "./src/attestation.ts",
    "./storage": "./src/storage.ts",
    "./compute": "./src/compute.ts",
    "./quest": "./src/quest.ts",
    "./env": "./src/env.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/foundry.test.ts"
  },
  "dependencies": {
    "@foundryprotocol/0gkit-core": "^0.1.0",
    "@foundryprotocol/0gkit-storage": "^0.1.0",
    "@foundryprotocol/0gkit-compute": "^0.1.0",
    "@foundryprotocol/0gkit-da": "^0.1.0",
    "@foundryprotocol/0gkit-attestation": "^0.1.0",
    "@foundryprotocol/0gkit-chain": "^0.1.0",
    "@0gfoundation/0g-compute-ts-sdk": "^0.8.3",
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.9",
    "@0gclawforge/sdk": "workspace:*",
    "circomlibjs": "^0.1.6",
    "crypto-js": "^4.2.0",
    "viem": "^2.21.0",
    "ethers": "^6.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/circomlibjs": "^0.1.6",
    "@types/crypto-js": "^4.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
